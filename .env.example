# ==============================================================================
# AI GitHub Code Reviewer - Environment Variables
# ==============================================================================
# Copy this file to .env or server/.env and fill in your actual credentials.
# NEVER commit your real secrets to Git.
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development

# Frontend Client URL (used for CORS and OAuth redirects)
CLIENT_URL=http://localhost:5173

# JWT Session Encryption Secret
JWT_SECRET=your_super_secret_jwt_encryption_key_min_32_chars

# GitHub OAuth Application Credentials
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:5001/api/auth/github/callback

# GitHub Webhook HMAC Secret (SHA-256)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_for_hmac

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Active AI Provider ('gemini' or 'openai' or 'hybrid')
AI_PROVIDER=gemini

# PostgreSQL + pgvector Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/code_reviewer

# Client-Side (Vite) API Base URL (if frontend is hosted on separate domain)
# VITE_API_URL=http://localhost:5001/api
